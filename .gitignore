# 忽略 Python 缓存
__pycache__/
*.py[cod]

# 忽略极大的原始测序数据和参考基因组
*.fastq
*.fastq.gz
*.fa
*.fna
*.fa.gz
*.fna.gz
raw_data/
reference/

# 忽略定量软件的庞大输出结果
quant_results/
abundance.tsv
*.h5

# 忽略中间过渡的 CSV 数据表 (但必须保留知识库)
*.csv
!default_knowledge_base/pareto_codon_blueprint.csv
!default_knowledge_base/yali_toxic_pairs.csv

# 忽略操作系统自动生成的垃圾文件
.DS_Store
Thumbs.db
